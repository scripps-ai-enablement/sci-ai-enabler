# Claude Code base action event log (written to the workspace during runs)
output.txt

# Transient prompts assembled by the workflows
.run-prompt.md
.digest-prompt.md

# Transient queue entry extracted by fulfill.yml for the on-demand run prompt
.fulfill-entry.txt

# Transient weekly digest written by the digest agent before it is posted
.digest.md

# Transient MCP config assembled by the coscientist workflow
.mcp-config.json

# Transient user-request issue bodies pre-fetched for the curator agents
.request-bodies/

# Example-bundle run outputs. The bundles document `--outdir results/...`, and
# seven workflows commit with `git add -A`, so without this an agent that ever
# executes an example sweeps its run artifacts into the repo.
# glyco-variants is the deliberate exception: its IEEE-2791 BioCompute Object
# declares `object_id: .../blob/main/recipes/examples/glyco-variants/results/
# glyco_run.bco.json`, and a BCO has to resolve at the URI it claims.
recipes/examples/*/results/
!recipes/examples/glyco-variants/results/

# macOS metadata
.DS_Store
__pycache__/
