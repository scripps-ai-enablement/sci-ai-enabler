{
  "description_domain": {
    "keywords": [
      "glycosylation",
      "N-linked",
      "O-linked",
      "sequon",
      "variant interpretation",
      "gain of glycosylation",
      "loss of glycosylation",
      "GlyGen",
      "BioMCP",
      "ClinVar",
      "AlphaMissense"
    ],
    "pipeline_steps": [
      {
        "description": "Retrieve annotated N-/O-glycosylation sites per protein from the GlyGen MCP server.",
        "input_list": [
          {
            "uri": "https://mcp.glygen.org/mcp"
          }
        ],
        "name": "GlyGen glycosite lookup",
        "output_list": [
          {
            "uri": "https://github.com/scripps-ai-enablement/sci-ai-enabler/blob/main/recipes/examples/glyco-variants/fixtures/glygen"
          }
        ],
        "step_number": 1
      },
      {
        "description": "Fetch the canonical UniProt sequence for the sequon check and numbering reconciliation.",
        "input_list": [
          {
            "uri": "https://rest.uniprot.org"
          }
        ],
        "name": "Canonical sequence fetch",
        "output_list": [
          {
            "uri": "https://github.com/scripps-ai-enablement/sci-ai-enabler/blob/main/recipes/examples/glyco-variants/fixtures/uniprot"
          }
        ],
        "step_number": 2
      },
      {
        "description": "Reconcile each variant against the canonical residue (else 'unmapped'), then classify by an N-X-S/T sequon delta and GlyGen O-glycosite loss.",
        "input_list": [
          {
            "filename": "variants.csv",
            "uri": "https://github.com/scripps-ai-enablement/sci-ai-enabler/blob/main/recipes/examples/glyco-variants/variants.csv"
          }
        ],
        "name": "Harmonize numbering + classify LOG/GOG",
        "output_list": [
          {
            "filename": "glyco_candidates.csv",
            "uri": "https://github.com/scripps-ai-enablement/sci-ai-enabler/blob/main/recipes/examples/glyco-variants/results/glyco_candidates.csv"
          }
        ],
        "step_number": 3
      },
      {
        "description": "Join ClinVar significance and AlphaMissense via the BioMCP variant getter's `predictions` section (MyVariant.info / dbNSFP).",
        "input_list": [
          {
            "uri": "https://myvariant.info"
          }
        ],
        "name": "Annotation join (BioMCP)",
        "output_list": [
          {
            "uri": "https://github.com/scripps-ai-enablement/sci-ai-enabler/blob/main/recipes/examples/glyco-variants/fixtures/biomcp"
          }
        ],
        "step_number": 4
      },
      {
        "description": "Rank GOG/LOG above none (unmapped last); within by AlphaMissense pathogenicity then ClinVar significance. Emit the candidate table.",
        "input_list": [
          {
            "filename": "glyco_candidates.csv",
            "uri": "https://github.com/scripps-ai-enablement/sci-ai-enabler/blob/main/recipes/examples/glyco-variants/results/glyco_candidates.csv"
          }
        ],
        "name": "Rank + report",
        "output_list": [
          {
            "filename": "glyco_candidates.csv",
            "uri": "https://github.com/scripps-ai-enablement/sci-ai-enabler/blob/main/recipes/examples/glyco-variants/results/glyco_candidates.csv"
          }
        ],
        "step_number": 5
      }
    ],
    "xref": [
      {
        "access_time": "2026-05-04T00:00:00Z",
        "ids": [
          "2.11.1"
        ],
        "name": "GlyGen data release",
        "namespace": "glygen.data.release"
      }
    ]
  },
  "error_domain": {
