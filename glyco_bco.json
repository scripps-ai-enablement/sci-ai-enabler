        "name": "UniProtKB",
        "ids": [
          "P01008",
          "P38484"
        ],
        "access_time": "2026-07-22T19:03:33+00:00"
      }
    ],
    "pipeline_steps": [
      {
        "step_number": 1,
        "name": "Resolve GlyGen protein + glycosites",
        "description": "GlyGen protein summary (canonical AC, sequence) and known N-/O-glycosites (site summary).",
        "input_list": [
          {
            "uri": "https://api.glygen.org/protein/detail/"
          }
        ],
        "output_list": [
          {
            "uri": "urn:glyco-variants:canonical_protein"
          }
        ]
      },
      {
        "step_number": 2,
        "name": "Harmonize numbering",
        "description": "Reconcile input residue position to canonical frame by WT-residue match; require a unique frame or log as unmapped.",
        "input_list": [
          {
            "uri": "https://rest.uniprot.org/uniprotkb/"
          }
        ],
        "output_list": [
          {
            "uri": "urn:glyco-variants:canonical_position"
          }
        ]
      },
      {
        "step_number": 3,
        "name": "Classify LOG/GOG/none",
        "description": "LOG if a known N-X-S/T sequon or annotated O-glycosite residue is removed; GOG if a new N-X-S/T sequon is created within +/-2; else none.",
        "input_list": [
          {
            "uri": "urn:glyco-variants:canonical_position"
          }
        ],
        "output_list": [
          {
            "uri": "urn:glyco-variants:class"
          }
        ]
      },
      {
        "step_number": 4,
        "name": "Join ClinVar + AlphaMissense via BioMCP",
        "description": "variant search, then variant get with explicit clinvar + predictions sections (AlphaMissense is in predictions).",
        "input_list": [
          {
            "uri": "https://biomcp.org/"
          }
        ],
        "output_list": [
          {
            "uri": "urn:glyco-variants:clinical_annotation"
          }
        ]
      },
      {
        "step_number": 5,
        "name": "Expression sanity-check",
        "description": "GlyGen Bgee/HPA tissue + BioXpress disease expression; missing tissue evidence demotes rank, never drops the candidate.",
        "input_list": [
          {
            "uri": "https://api.glygen.org/protein/detail/"
          }
        ],
        "output_list": [
          {
            "uri": "urn:glyco-variants:expression_flag"
          }
        ]
      },
      {
        "step_number": 6,
        "name": "Rank + emit candidates",
        "description": "Rank LOG/GOG above none (unmapped last), demote missing-expression, then AlphaMissense then ClinVar; write glyco_candidates.csv.",
        "input_list": [
          {
            "uri": "urn:glyco-variants:clinical_annotation"
          }
        ],
        "output_list": [
          {
            "uri": "file://glyco_candidates.csv"
          }
        ]
      }
    ]
  },
