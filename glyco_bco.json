  "usability_domain": [
    "Classify missense variants by their effect on protein N-/O-glycosylation (loss LOG, gain GOG, or none), after reconciling input residue numbering with GlyGen canonical numbering.",
    "Prioritize glyco-impacting variants by AlphaMissense pathogenicity and ClinVar clinical significance for downstream review."
  ],
  "description_domain": {
    "keywords": [
      "glycosylation",
      "N-X-S/T sequon",
      "variant effect",
      "GlyGen",
      "ClinVar",
      "AlphaMissense",
      "numbering harmonization"
    ],
