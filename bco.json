  "provenance_domain": {
    "name": "Glyco-variant LOG/GOG classification with expression sanity-check and ClinVar/AlphaMissense join",
    "version": "1.0.0",
    "created": "2026-07-22T18:25:28+00:00",
    "modified": "2026-07-22T18:25:28+00:00",
    "contributors": [
